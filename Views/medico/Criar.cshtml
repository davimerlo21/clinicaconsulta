@model clinicaconsulta.Models.Medico

@{
    ViewData["Title"] = "Cadastrar Médico";
}

<div class="container mt-4">
    <h2>Cadastrar Médico</h2>
    <hr />
    <form asp-action="Criar" method="post">
        <div class="form-group mb-3">
            <label asp-for="Nome" class="control-label"></label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Crm" class="control-label"></label>
            <input asp-for="Crm" class="form-control" />
            <span asp-validation-for="Crm" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="EspecialidadeId" class="control-label">Especialidade</label>
            <select asp-for="EspecialidadeId" class="form-control" asp-items="ViewBag.Especialidades">
                <option value="">Selecione uma especialidade</option>
            </select>
            <span asp-validation-for="EspecialidadeId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <button type="submit" class="btn btn-success">Salvar</button>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </div>
    </form>
</div>