@model clinicaconsulta.Models.Especialidade

@{
    ViewData["Title"] = "Nova Especialidade";
}

<div class="container mt-4">
    <h2>Cadastrar Nova Especialidade</h2>
    <hr />

    <form asp-action="Criar" method="post">
        <div class="form-group mb-3">
            <label asp-for="Nome" class="control-label">Nome da Especialidade</label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>
        <div class="form-group">
            <button type="submit" class="btn btn-success">Salvar</button>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </div>
    </form>
</div>